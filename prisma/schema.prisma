// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                    Int            @id @default(autoincrement())
  nome                  String         @db.VarChar(255)
  email                 String         @unique @db.VarChar(255)
  senha                 String         @db.VarChar(255)
  data_nascimento       DateTime       @db.Date
  telefone              String?        @db.VarChar(50)
  genero                String?        @db.VarChar(50)
  email_verificado      Boolean        @default(false)
  codigo_verificacao    String?        @db.VarChar(50)
  codigo_recuperacao    String?        @db.VarChar(50)
  tentativas_recuperacao Int            @default(0)

  diagnosticos          Diagnostico[]
  diarios               Diario[]

  @@map("usuarios")
}

model Diagnostico {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  texto      String   @db.Text
  data_hora  DateTime @default(now()) @db.Timestamp

  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("diagnosticos")
}

model Diario {
  id                    Int      @id @default(autoincrement())
  usuario_id            Int
  data_hora             DateTime @default(now()) @db.Timestamp
  titulo                String   @db.VarChar(255)
  texto                 String   @db.Text
  emocao_predominante   String?  @db.VarChar(255)
  intensidade_emocional String?  @db.VarChar(255)
  comentario_athena     String?  @db.Text

  usuario               Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("diario")
}

